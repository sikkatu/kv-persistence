# lmcache-server.env — settings for the standalone lmcache server process.
# Consumed by scripts/start-cache.sh. The L2 adapter JSON is assembled from
# the KVP_* values so there is a single source of truth (configs/generic/cache.env).

# MP server request port (vLLM connects here; ZMQ).
LMCACHE_HOST=127.0.0.1
LMCACHE_PORT=5555

# HTTP frontend for health / metrics / admin. Bind loopback; do NOT expose the
# management API without authentication to any routable interface.
LMCACHE_HTTP_HOST=127.0.0.1
LMCACHE_HTTP_PORT=8080

# L1 tier (host RAM) size; the durable tier is L2 on NVMe.
LMCACHE_L1_SIZE_GB=64

# Token chunk granularity (256 is the documented production default).
LMCACHE_CHUNK_SIZE=256

# Eviction policy for BOTH tiers. trigger_watermark is the soft threshold
# fraction of the tier budget; eviction_ratio is how much is reclaimed when it
# fires. The hard L2 bound (max_capacity_gb) is enforced independently by the
# nixl_store_dynamic adapter.
LMCACHE_EVICTION_POLICY=LRU
LMCACHE_EVICTION_TRIGGER_WATERMARK=0.9
LMCACHE_EVICTION_RATIO=0.1

# ---- L2 storage codec (LOSSLESS ONLY) ------------------------------------
# How KV chunks are encoded before they hit NVMe. The whole project is
# LOSSLESS by design -- lossy quantization (fp8 / turboquant / lbq) is NOT
# available here and must not be added: decoded KV must be bit-identical to
# the engine's cache.
#   none  (default) = byte-exact raw chunks, identical to the uncompressed
#                     upstream path. Nothing is transformed.
#   zstd            = lossless zstd compression (kvp-zstd serde).
#   lz4             = lossless lz4 compression (kvp-lz4 serde), faster, lower
#                     ratio.
# Expected size reduction is modest -- roughly 1.1-1.4x on real KV payloads --
# and blocks that do not shrink are stored raw, so a chunk never grows.
# The value is part of the cache identity namespace: changing it makes the
# old chunks a safe cache MISS (never a wrong read).
LMCACHE_L2_SERDE=none

# Convenience switch for scripts/start-cache.sh (not read by the Python
# loader). USE_LOSSLESS_SERDE=1 enables zstd; =lz4 / =zstd pick the codec
# explicitly; unset/0 keeps the byte-exact raw mode above. It only ever maps
# to LMCACHE_L2_SERDE -- the two must agree, the env value wins.
# USE_LOSSLESS_SERDE=1

# ---- Sizing for a ~200 GB KV working set (documented profile) ------------
# A chat with up to ~200 GB of KV needs room for that plus growth headroom:
#   l1_size_gb      : 30-40 GB of host RAM is a good L1 buffer
#                     (KVP_L1_SIZE_GB / LMCACHE_L1_SIZE_GB below).
#   l2_capacity_gb  : >= 250-300 GB on a DEDICATED local NVMe device.
# The shipped defaults are deliberately generous (KVP_CACHE_BUDGET_GB=1500)
# because the cache root lives on the same volume as the OS/model on the
# reference host; on a dedicated NVMe you may lower the budget to 300.
# Set the disk path with KVP_CACHE_ROOT and pin the device with
# KVP_CACHE_DEVICE so preflight can prove the cache sits on the right disk.

# ---- Observability (optional, off by default) ----------------------------
# The monitoring stack (Prometheus + Grafana + Tempo + OTel Collector) is
# started separately with scripts/start-observability.sh. The cache service
# works fine WITHOUT it: telemetry is opt-in.
#   KVP_OTLP_ENDPOINT     -- OTLP gRPC endpoint the lmcache server pushes
#                            metrics/traces to (e.g. http://localhost:4320,
#                            the default collector port of the shipped stack).
#   USE_OBSERVABILITY     -- set to 1 as a shorthand for pointing
#                            KVP_OTLP_ENDPOINT at http://localhost:4320.
#   LMCACHE_OTLP_ENDPOINT -- the same endpoint under the LMCACHE_* name; when
#                            both are set, the LMCACHE_* value wins.
# KVP_OTLP_ENDPOINT=http://localhost:4320

# Compression level for the lossless serde codecs (zstd only; lz4 ignores
# it). Higher = better ratio, slower store. 1-19 for zstd, default 3.
KVP_L2_COMPRESS_LEVEL=3