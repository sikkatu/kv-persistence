> Локализованная версия configs/generic/cache.env — комментарии переведены.
> Имена переменных, значения и порядок совпадают с английской эталонной версией
> (контролируется тестами: tests/unit/test_config_locales.py). Скрипты читают
> английский файл; эту версию можно переименовать в cache.env для работы.

# cache.env — настройки постоянного KV-кэша (общие; подключаются всеми скриптами).
# Скопируйте в cache.env.local и правьте; .local в .gitignore. Окружение важнее файла.

# ---- Бюджет хранилища (жёсткий лимит) -------------------------------------
# Максимум диска под данные постоянного KV-кэша. Физический потолок — 1 ТБ на
# целевом NVMe; 750 ГБ оставляют место под ОС, накладные расходы ФС и прочие данные.
KVP_CACHE_BUDGET_GB=750

# Где живёт постоянный кэш. ДОЛЖЕН быть локальным NVMe-путём, а не сетевой шарой
# (задержки и семантика rename ломают атомарные записи).
KVP_CACHE_ROOT=/var/lib/kv-persistence/l2

# ---- Политика эвикции (мягкий порог отделён от жёсткого лимита) -----------
# Эвикция начинается на 90% бюджета; возврат до 85% за один цикл.
KVP_EVICT_TRIGGER_WATERMARK=0.9
KVP_EVICT_RATIO=0.1

# ---- lmcache-сервер -------------------------------------------------------
# Порт запросов, куда подключается vLLM (по умолчанию ZMQ). Оставляйте loopback.
KVP_LMCACHE_HOST=127.0.0.1
KVP_LMCACHE_PORT=5555
# HTTP-фронтенд управления/метрик. Биндить только loopback: никогда не открывать
# неаутентифицированный управление на внешнем интерфейсе.
KVP_LMCACHE_HTTP_PORT=8080
# Размер уровня L1 в ГБ (буфер в RAM хоста между vLLM и NVMe).
KVP_L1_SIZE_GB=64
# Размер чанка в токенах; 256 — задокументированный продовый дефолт.
KVP_CHUNK_SIZE=256

# ---- Расположение хранилища (проверка устройства) ------------------------
# Закрепите физическое устройство KVP_CACHE_ROOT (например, /dev/nvme1n1);
# preflight сопоставляет путь кэша с блочным устройством через findmnt/lsblk и
# ПАДАЕТ, если они не совпадают. Не задано = preflight не может доказать, что
# кэш лежит на нужном NVMe — при бюджете 750 ГБ не тот диск молча съест системный.
# Сначала посмотрите нужное устройство: lsblk
# KVP_CACHE_DEVICE=/dev/nvme1n1
# Сохранять файлы данных при выключении (persist/recover между рестартами).
KVP_PERSIST_ENABLED=true
# Полностью обойти постоянный кэш (ничего не сохраняется; для A/B).
KVP_CACHE_BYPASS=0
# Метка пространства — только для людей. НЕ влияет на совместимость.
KVP_NAMESPACE_HINT=