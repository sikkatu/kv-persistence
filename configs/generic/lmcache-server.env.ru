> Локализованная версия configs/generic/lmcache-server.env — комментарии переведены.
> Имена переменных, значения и порядок совпадают с английской эталонной версией.

# lmcache-server.env — настройки отдельного процесса lmcache-сервера.
# Используются scripts/start-cache.sh. Конфиг L2-адаптера собирается из значений
# KVP_*, чтобы был один источник истины (configs/generic/cache.env).

# Порт запросов MP-сервера (сюда подключается vLLM; ZMQ).
LMCACHE_HOST=127.0.0.1
LMCACHE_PORT=5555

# HTTP-фронтенд для здоровья / метрик / администрирования. Только loopback:
# не подвергать неаутентифицированный управление доступным интерфейсам.
LMCACHE_HTTP_HOST=127.0.0.1
LMCACHE_HTTP_PORT=8080

# Уровень L1 (RAM хоста); постоянный уровень — L2 на общем диске ВМ.
LMCACHE_L1_SIZE_GB=64

# Гранулярность чанка в токенах (256 — задокументированный продовый дефолт).
LMCACHE_CHUNK_SIZE=256

# Политика эвикции для ОБОИХ уровней. trigger_watermark — мягкий порог как доля
# бюджета уровня; eviction_ratio — сколько возвращается при срабатывании.
# Жёсткую границу L2 (max_capacity_gb) независимо обеспечивает адаптер
# nixl_store_dynamic.
LMCACHE_EVICTION_POLICY=LRU
LMCACHE_EVICTION_TRIGGER_WATERMARK=0.9
LMCACHE_EVICTION_RATIO=0.1

# ---- Кодек хранения L2 (ТОЛЬКО LOSSLESS) --------------------------------
# Как кодируются KV-чанки перед записью на NVMe. Весь проект — lossless по
# дизайну: lossy-квантизация (fp8 / turboquant / lbq) здесь НЕ доступна и не
# должна добавляться — декодированный KV обязан быть бит-в-бит идентичен
# кэшу движка.
#   none  (дефолт) = байт-точные сырые чанки, идентичные несжатому upstream
#                    пути. Ничего не трансформируется.
#   zstd            = lossless-сжатие zstd (serde kvp-zstd).
#   lz4             = lossless-сжатие lz4 (serde kvp-lz4), быстрее, ниже
#                     коэффициент.
# Ожидаемое уменьшение размера скромное — примерно 1.1-1.4x на реальных
# KV-данных — а блоки, которые не сжимаются, хранятся сырыми, поэтому чанк
# никогда не растёт. Значение входит в namespace идентичности кэша: его
# смена превращает старые чанки в безопасный cache MISS (никогда не в
# неверное чтение).
LMCACHE_L2_SERDE=none

# Удобный переключатель для scripts/start-cache.sh (Python-загрузчик его не
# читает). USE_LOSSLESS_SERDE=1 включает zstd; =lz4 / =zstd выбирают кодек
# явно; не задано/0 оставляет байт-точный сырой режим выше. Он лишь отображается
# в LMCACHE_L2_SERDE — значения должны совпадать, значение env выигрывает.
# USE_LOSSLESS_SERDE=1

# ---- Расчёты под рабочий набор KV ~200 ГБ (задокументированный профиль) ---
# Чату с KV до ~200 ГБ нужно место под них плюс запас на рост:
#   l1_size_gb      : 30-40 ГБ RAM хоста — хороший буфер L1
#                     (KVP_L1_SIZE_GB / LMCACHE_L1_SIZE_GB ниже).
#   l2_capacity_gb  : >= 250-300 ГБ на ВЫДЕЛЕННОМ локальном NVMe-устройстве.
# Поставляемые дефолты намеренно щедрые (KVP_CACHE_BUDGET_GB=1500), потому
# что корень кэша живёт на том же томе, что и ОС/модель, на эталонном хосте;
# на выделенном NVMe бюджет можно снизить до 300. Путь к диску задаётся
# KVP_CACHE_ROOT, а устройство фиксируется KVP_CACHE_DEVICE — чтобы preflight
# доказал: кэш лежит на нужном диске.

# ---- Наблюдаемость (опционально, по умолчанию выключена) -----------------
# Стек мониторинга (Prometheus + Grafana + Tempo + OTel Collector) поднимается
# отдельно скриптом scripts/start-observability.sh. Кэш-сервис полноценно
# работает и БЕЗ него: телеметрия — только по желанию.
#   KVP_OTLP_ENDPOINT     -- OTLP gRPC endpoint, куда lmcache-сервер отправляет
#                            метрики/трейсы (например http://localhost:4320 —
#                            порт коллектора по умолчанию в поставляемом стеке).
#   USE_OBSERVABILITY     -- выставьте 1, чтобы направить KVP_OTLP_ENDPOINT на
#                            http://localhost:4320.
#   LMCACHE_OTLP_ENDPOINT -- тот же endpoint под именем LMCACHE_*; если заданы
#                            оба, выигрывает значение LMCACHE_*.
# KVP_OTLP_ENDPOINT=http://localhost:4320

# Уровень сжатия lossless-кодеков (только zstd; lz4 его игнорирует).
# Выше — лучше коэффициент, медленнее запись. Для zstd 1-19, дефолт 3.
KVP_L2_COMPRESS_LEVEL=3

# Уровень логирования сервиса кэша. "DEBUG" НЕОБХОДИМ для аппаратной приёмки
# (scripts/test-recovery.sh): строки-доказательства L2 store/load
# ("L2 store completed: adapter %d, %d succeeded, %d failed" и
# "L2 prefetch load completed: request %d, %d loaded, %d failed") в
# закреплённой сборке LMCache 0.5.3 пишутся на уровне DEBUG. Без DEBUG
# регэкспы приёмки ничего не найдут, и прогон станет INCONCLUSIVE. "INFO"
# уменьшает лог для продакшена, если приёмка не планируется.
LMCACHE_LOG_LEVEL=DEBUG