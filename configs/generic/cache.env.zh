> configs/generic/cache.env 的本地化版本 —— 仅翻译注释。
> 变量名、值与顺序和英文基准版完全一致（由测试保证：
> tests/unit/test_config_locales.py）。脚本读取英文文件；如需使用本版本，
> 请将其重命名为 cache.env。

# cache.env —— 持久化缓存配置（通用；被所有脚本来源化）。
# 复制为 cache.env.local 后编辑；.local 已在 .gitignore 中。环境变量优先于文件。

# ---- 存储预算（硬上限）------------------------------------------------------
# 分配给持久化缓存数据的磁盘上限。目标 NVMe 物理上限为 1 TB；
# 750 GB 为操作系统、文件系统开销和其他数据留出空间。
KVP_CACHE_BUDGET_GB=750

# 持久缓存所在位置。必须是本地 NVMe 路径，绝不能是网络共享
# （延迟和重命名语义会破坏原子写入）。
KVP_CACHE_ROOT=/var/lib/kv-persistence/l2

# ---- 淘汰策略（软阈值与硬上限分离）----------------------------------------
# 预算使用到 90% 时开始淘汰；一个周期内回收到 85%。
KVP_EVICT_TRIGGER_WATERMARK=0.9
KVP_EVICT_RATIO=0.1

# ---- lmcache 服务 ----------------------------------------------------------
# vLLM 连接的请求端口（默认 ZMQ）。保持回环。
KVP_LMCACHE_HOST=127.0.0.1
KVP_LMCACHE_PORT=5555
# HTTP 管理/指标前端。仅绑定回环：绝不在可路由接口上暴露未认证的管理端点。
KVP_LMCACHE_HTTP_PORT=8080
# L1 层大小（GB），vLLM 与 NVMe 之间的主机内存缓冲。
KVP_L1_SIZE_GB=64
# 块大小（token 数）；256 是文档化生产默认值。
KVP_CHUNK_SIZE=256

# ---- 缓存行为 ---------------------------------------------------------------
# 关机时保留数据文件（跨重启持久/恢复）。
KVP_PERSIST_ENABLED=true
# 完全绕过持久缓存（不再存储数据；用于 A/B 对比）。
KVP_CACHE_BYPASS=0
# 命名空间标签 —— 仅人类可读。不影响兼容性。
KVP_NAMESPACE_HINT=