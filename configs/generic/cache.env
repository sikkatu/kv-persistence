# cache.env — persistent KV cache settings (generic; sourced by all scripts).
# Copy to cache.env.local and edit; .local is gitignored. Environment wins over file.

# ---- Storage budget (the hard bound) --------------------------------------
# Max disk allocated to persistent KV-cache data. Physical ceiling is 1 TB on
# the target NVMe; 750 GB leaves room for OS, filesystem overhead and other data.
KVP_CACHE_BUDGET_GB=750

# Where the persistent cache lives. MUST be a local NVMe path, never a
# network share (latency/rename semantics break atomic writes).
KVP_CACHE_ROOT=/var/lib/kv-persistence/l2

# ---- Eviction policy (soft threshold distinct from the hard limit) --------
# Start evicting at 90% of budget; reclaim down to 85% per cycle window.
KVP_EVICT_TRIGGER_WATERMARK=0.9
KVP_EVICT_RATIO=0.1

# ---- LMCache server -------------------------------------------------------
# Request port vLLM connects to (ZMQ by default). Keep it loopback-only.
KVP_LMCACHE_HOST=127.0.0.1
KVP_LMCACHE_PORT=5555
# HTTP management/metrics frontend. Bind loopback: never expose unauthenticated.
KVP_LMCACHE_HTTP_PORT=8080
# L1 tier size in GB (host RAM buffer between vLLM and NVMe).
KVP_L1_SIZE_GB=64
# Chunk size in tokens; 256 is the documented production default.
KVP_CHUNK_SIZE=256

# ---- Storage location (device-level check) -------------------------------
# Pin the physical device of KVP_CACHE_ROOT (e.g. /dev/nvme1n1); preflight maps
# the cache path to its block device via findmnt/lsblk and FAILS if it does not
# match. Unset = preflight cannot prove the cache sits on the intended NVMe --
# on a 750 GB budget a wrong disk would silently consume the system drive.
# Find the right device first with: lsblk
# KVP_CACHE_DEVICE=/dev/nvme1n1
# Keep data files on disk on shutdown (persist/recover across restarts).
KVP_PERSIST_ENABLED=true
# Bypass the persistent cache entirely (still stores nothing; used for A/B).
KVP_CACHE_BYPASS=0
# Namespace hint label only — does NOT affect compatibility identity.
KVP_NAMESPACE_HINT=