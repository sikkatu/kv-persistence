// configs/mimo-v2.6-pro/l2-adapter.json.in 的本地化版本 —— 仅翻译注释。
// JSON 键与占位符和英文基准版完全一致。

// kv-persistence 中 MiMo-V2.6-Pro 的 L2 适配器规范模板。
// nixl_store_dynamic 是 LMCache 里唯一文档化了 persist/recover 语义的适配器：
// 启动时内存索引为空，每次查找未命中都会落到磁盘上的确定性文件（索引惰性重建）。
// persist_enabled 显式写出，避免其取值随上游默认值悄悄变化。
//
// backend: POSIX —— 标准文件 I/O，适用于任何本地文件系统。这里*刻意*不用 GDS：
// 先用最简单可靠的 NVMe 路径，等持久化被证实后再说；主机 PCIe 拓扑
// （Gen 4，其中一卡 x8）也享受不到 GDS 的好处。
//
// file_path —— 必须位于本地 NVMe（KVP_CACHE_ROOT）。绝不能是网络挂载。
// max_capacity_gb —— 硬预算；超过即拒绝写入。淘汰控制器据此计算用量。
//   默认 750，上限 1 TB。
//
// eviction —— 每个适配器可独立启用。作用于 KV 块键的 LRU；后台线程监视
//   get_usage()，超过 trigger_watermark 后按 eviction_ratio 回收。这是自动
//   维护路径；更细的 value-based 策略见
//   implementation/kvpersist/retention.py（有逐条统计时用于排序）。
//
// serde —— 无损存储编解码，由 __KVP_L2_SERDE_JSON__ 展开。
//   默认是“无”（没有 "serde" 键）：块逐字节精确写入，与未压缩的 upstream
//   路径完全一致。编解码通过 LMCACHE_L2_SERDE=zstd|lz4（规范开关，所有
//   启动器都读它）或简写 USE_LOSSLESS_SERDE=1 选择；KVP_L2_SERDE 作为别名
//   也被接受。该片段渲染 "serde" 块，使用 kvpersist.compress_serde 注册的
//   无损编解码（kvp-zstd / kvp-lz4）。
//   本模板中不存在有损量化：fp8 与 turboquant 被有意排除且必须保持排除
//   （任务要求：“никакого fp8 / turboquant / lbq по умолчанию”）。
//   无损 raw 模式下渲染片段为 ""（无 serde 键），选择编解码时为
//   `"serde": { ... },`。
{
  "type": "nixl_store_dynamic",
  "backend": "POSIX",
  "backend_params": {
    "file_path": "__KVP_CACHE_ROOT__",
    "use_direct_io": "false",
    "max_capacity_gb": "__KVP_CACHE_BUDGET_GB__"
  },
  "persist_enabled": true,
  __KVP_L2_SERDE_JSON__
  "eviction": {
    "eviction_policy": "LRU",
    "trigger_watermark": __KVP_EVICT_TRIGGER_WATERMARK__,
    "eviction_ratio": __KVP_EVICT_RATIO__
  }
}