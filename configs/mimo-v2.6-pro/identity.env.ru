> Локализованная версия configs/mimo-v2.6-pro/identity.env — комментарии переведены.
> Имена переменных, значения и порядок совпадают с английской эталонной версией.

# identity.env — пины совместимости MiMo-V2.6-Pro-MOPD для production-конфигурации
# 4x RTX PRO 6000 (baseline только для чтения: sikkatu/recipes,
# recipes/rtx-pro-6000/mimo-v2.6-pro-hotsplit).
#
# КАЖДОЕ значение участвует в пространстве кэша: изменение любого из них делает
# старые постоянные записи несовместимыми => промах кэша, никогда неверный hit.
# Скрипты проверяют значения при старте; пустое значение — ошибка.

# Идентичность модели
KVP_MODEL_ID=XiaomiMiMo/MiMo-V2.6-Pro-MOPD
# ОБЯЗАТЕЛЬНО, 40 hex. Допустимы ОБА формата, но они означают разное —
# в одном деплое используется только один:
#   a) ОТПЕЧАТОК ЛОКАЛЬНОГО ЧЕКПОЙНТА (что пишет setup-identity.sh, если не
#      задано): детерминированный дайджест config.json + всех weight-index +
#      всех шардов (имя+размер), реально лежащих на диске. Это НЕ SHA коммита —
#      он идентифицирует именно используемые файлы.
#   b) SHA коммита апстрима — ТОЛЬКО если вы осознанно отслеживаете
#      происхождение с HF, задайте ДО запуска setup-identity.sh:
#        curl -fsSL https://huggingface.co/api/models/XiaomiMiMo/MiMo-V2.6-Pro-MOPD \
#          | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
#      Замечание: HEAD ветки репозитория — это не обязательно ревизия ваших
#      локально скачанных файлов.
KVP_MODEL_REVISION=

# Идентичность токенизатора (тот же репо; ревизия может отличаться от весов, только
# если файлы токенизатора реально взяты из другого коммита — задаётся осознанно).
KVP_TOKENIZER_NAME=XiaomiMiMo/MiMo-V2.6-Pro-MOPD
KVP_TOKENIZER_REVISION=

# Эффективный KV-cache dtype. «auto» здесь НЕ принимается: идентичность должна
# использовать разрешённый dtype. Production-рецепт сегодня ставит
# значение KV_CACHE_DTYPE=auto=bf16; целевая конфигурация проекта — fp16 —
# укажите то, что ФАКТИЧЕСКИ работает.
KVP_KV_CACHE_DTYPE=bf16

# Геометрия KV (из работающего движка: vLLM печатает «GPU KV cache size» и размер
# блока при старте; значения ниже соответствуют закреплённой сборке — сверьте по логу).
KVP_BLOCK_SIZE=16
KVP_NUM_KV_HEADS=8
KVP_HEAD_DIM=128

# Параллелизм и раскладка
KVP_TP_SIZE=4

# Идентичность коннектора
KVP_CONNECTOR=LMCacheMPConnector
# Закреплённая реализация коннектора. Для production-образа (>=0.20.0)
# всегда указываем kv_connector_module_path на коннектор из LMCache; эта строка
# также фиксирует сборку vLLM, с которой всё проверялось.
KVP_CONNECTOR_VERSION=vllm-8e2beaa3bff@lmcache-mp

# Контекстные настройки, существенно влияющие на раскладку
KVP_MAX_MODEL_LEN=1048576

# SHA-256 применяемого файла чат-шаблона (64 hex). Считается scripts/preflight.sh
# из каталога модели; вручную заполняйте только если preflight не может получить
# доступ к каталогу. Изменение шаблона инвалидирует закэшированные префиксы,
# потому что меняются токены промпта.
KVP_CHAT_TEMPLATE_DIGEST=