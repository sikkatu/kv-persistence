# identity.env — compatibility identity pins for MiMo-V2.6-Pro-MOPD on the
# 4x RTX PRO 6000 production deployment (read-only baseline: sikkatu/recipes
# recipes/rtx-pro-6000/mimo-v2.6-pro-hotsplit).
#
# EVERY value here participates in the cache namespace: changing any of them
# makes old persistent entries incompatible -> cache miss, never a wrong hit.
# The scripts verify these at startup; an empty value is an error.

# Model identity
KVP_MODEL_ID=XiaomiMiMo/MiMo-V2.6-Pro-MOPD
# REQUIRED, 40-hex. The recognised formats are BOTH valid but mean different
# things -- only one goes here per deployment:
#   a) LOCAL CHECKPOINT FINGERPRINT (what setup-identity.sh writes when unset):
#      a deterministic digest of config.json + every weight-index + every shard
#      (name+size) actually on disk. It is NOT a commit SHA -- it identifies
#      exactly the files being served.
#   b) The upstream commit SHA, ONLY if you deliberately track HF provenance:
#        curl -fsSL https://huggingface.co/api/models/XiaomiMiMo/MiMo-V2.6-Pro-MOPD \
#          | python3 -c 'import json,sys; print(json.load(sys.stdin)["sha"])'
#      before running setup-identity.sh. Note that HEAD of the remote branch is
#      NOT necessarily the revision of your locally downloaded files.
KVP_MODEL_REVISION=

# Tokenizer identity (same repo; revision may differ from weights only if the
# tokenizer files actually come from a different commit — set deliberately).
KVP_TOKENIZER_NAME=XiaomiMiMo/MiMo-V2.6-Pro-MOPD
KVP_TOKENIZER_REVISION=

# Effective KV-cache dtype. "auto" is NOT accepted here: the identity must use
# the resolved dtype. The production recipe sets KV_CACHE_DTYPE=auto=bf16 today;
# the target configuration for this project is fp16 — set what is ACTUALLY running.
KVP_KV_CACHE_DTYPE=bf16

# KV geometry (from the served engine: vLLM logs "GPU KV cache size" and block
# size at startup; defaults below match the pinned build, verify in logs).
KVP_BLOCK_SIZE=16
KVP_NUM_KV_HEADS=8
KVP_HEAD_DIM=128

# Parallelism and layout
KVP_TP_SIZE=4

# Connector identity
KVP_CONNECTOR=LMCacheMPConnector
# Pinned connector implementation. For the production image (>=0.20.0 contract)
# we always set kv_connector_module_path to the LMCache-shipped connector; this
# string also pins the vLLM build it was validated against.
KVP_CONNECTOR_VERSION=vllm-8e2beaa3bff@lmcache-mp

# Context settings that materially affect layout
KVP_MAX_MODEL_LEN=1048576

# SHA-256 of the applied chat template file (64 hex). Computed by
# scripts/preflight.sh from the served model's chat template; set manually here
# only when preflight cannot reach the model dir. A template change invalidates
# cached prefixes because prompt tokens change.
KVP_CHAT_TEMPLATE_DIGEST=