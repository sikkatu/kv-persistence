# pinned-base-image.env -- THE single source of the base vLLM image digest.
#
# r6-7 B-1: this pin used to be duplicated across a dozen places (README,
# tp4.env.example in three languages, build-image.sh header...). It lives
# HERE only; every doc points at this file.
#
# Resolution order in scripts/build-lmcache.sh and scripts/build-image.sh:
#   1. KVP_BASE_IMAGE from the environment (explicit override),
#   2. KVP_BASE_IMAGE_DEFAULT from THIS file.
# The old IMAGE / KVP_LMC_IMAGE variables are IGNORED by the build scripts
# (a warning is printed if IMAGE is set) -- IMAGE has a DIFFERENT meaning in
# the runtime chain (the CUSTOM derivative image, see live/image).
#
# The pin must always be a full digest pin: repo:tag@sha256:<64 hex>. A
# floating tag is refused.
KVP_BASE_IMAGE_DEFAULT="vllm/vllm-openai:nightly-8e2beaa3bff595577a069d49d96bde9074294ec2@sha256:167ccd8696bc09f1b63301185134e04b883623f8adcbd8e3a0ec3140a193abcf"