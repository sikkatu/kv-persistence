#!/usr/bin/env bash
# kvp-lmcache-server -- wrapper for the systemd unit.
#
# Why a wrapper: the pinned LMCache 0.5.3 CLI takes --l2-adapter as a JSON
# STRING (it does json.loads on the value), NOT a file path. systemd's
# ExecStart does not support $(cat ...) expansion, so the wrapper reads (or
# renders) the adapter spec and passes its content inline.
#
# INSTALL:
#   sudo install -m 0755 systemd/kvp-lmcache-server /usr/local/sbin/kvp-lmcache-server
#   sudo install -m 0644 systemd/lmcache-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now lmcache-server
#
# Usage: kvp-lmcache-server [rendered-l2-adapter.json]
# All other settings (host, port, L1 size, chunk size, eviction, HTTP) come
# from the environment (/etc/kv-persistence.env), matching scripts/start-cache.sh.
set -Eeuo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# When installed to /usr/local/sbin the repo may not be nearby; allow an
# explicit repo root for template rendering.
REPO_ROOT="${KVP_REPO_ROOT:-}"
[ -z "$REPO_ROOT" ] && [ -d "$HERE/../configs" ] && REPO_ROOT="$(cd "$HERE/.." && pwd)"
# The wrapper launches `python3 -m kvpersist.salt_filename_patch`, which lives
# in the repo's implementation/ directory -- it must be importable.
if [ -n "$REPO_ROOT" ] && [ -d "$REPO_ROOT/implementation" ]; then
  export PYTHONPATH="$REPO_ROOT/implementation${PYTHONPATH:+:$PYTHONPATH}"
fi
ADAPTER_FILE="${1:-}"

# Review round 14: the settings below must come from the REPO config files
# (cache.env / cache.env.local), not from bare defaults -- docs/deployment.md
# tells users to pin KVP_CACHE_ROOT and the budget in cache.env.local, and
# start-cache.sh honours them ("env wins" over files). Reading only
# /etc/kv-persistence.env here would render file_path=/var/lib/kv-persistence/l2
# with a 1.5 TB budget while the real cache lives elsewhere (a 1.5 TB cache on
# the system disk). The effective value = process env > repo .local > repo base
# > the defaults below -- identical to scripts/env.sh.
repo_cfg() { # repo_cfg <KEY> <default>
  local k="$1" def="$2" v="" alias=""
  # Review fix (round 27): the repo config files carry BOTH spellings --
  # cache.env(.local) uses the KVP_* alias (KVP_LMCACHE_PORT, KVP_L1_SIZE_GB,
  # ...), lmcache-server.env uses LMCACHE_*. Look up the alias too so a
  # KVP_* edit in cache.env.local is honoured under systemd, exactly like
  # scripts/env.sh (_kvp_load_env propagates KVP_* -> LMCACHE_*).
  case "$k" in
    LMCACHE_HOST)                    alias=KVP_LMCACHE_HOST ;;
    LMCACHE_PORT)                    alias=KVP_LMCACHE_PORT ;;
    LMCACHE_HTTP_PORT)               alias=KVP_LMCACHE_HTTP_PORT ;;
    LMCACHE_L1_SIZE_GB)              alias=KVP_L1_SIZE_GB ;;
    LMCACHE_CHUNK_SIZE)              alias=KVP_CHUNK_SIZE ;;
    LMCACHE_EVICTION_TRIGGER_WATERMARK) alias=KVP_EVICT_TRIGGER_WATERMARK ;;
    LMCACHE_EVICTION_RATIO)          alias=KVP_EVICT_RATIO ;;
  esac
  if [ -n "$REPO_ROOT" ]; then
    # Review fix (round 27, part 2): the KVP_* alias wins over the LMCACHE_*
    # file value -- identical to env.sh propagation, where KVP_* overrides
    # what the files set (lmcache-server.env always ships LMCACHE_PORT=5555,
    # so an "only if empty" rule would ignore a KVP_LMCACHE_PORT edit).
    if [ -n "$alias" ]; then
      v="$(sed -n "s/^${alias}=//p" \
          "$REPO_ROOT/configs/generic/cache.env" \
          "$REPO_ROOT/configs/generic/cache.env.local" 2>/dev/null \
          | tail -1 | tr -d '\"' | sed 's/ *#.*//')"
    fi
    if [ -z "$v" ]; then
      v="$(sed -n "s/^${k}=//p" \
          "$REPO_ROOT/configs/generic/cache.env" \
          "$REPO_ROOT/configs/generic/cache.env.local" \
          "$REPO_ROOT/configs/generic/lmcache-server.env" \
          "$REPO_ROOT/configs/generic/lmcache-server.env.local" 2>/dev/null \
          | tail -1 | tr -d '\"' | sed 's/ *#.*//')"
    fi
  fi
  # Review fix (round 37): expand $HOME/${HOME} in file values -- cache.env
  # may pin paths like KVP_CACHE_ROOT=$HOME/nvme/kvp (identical to the
  # shared env-file parsers, round 33).
  v="${v:-}"
  v="${v//\$\{HOME\}/$HOME}"
  v="${v//\$HOME/$HOME}"
  echo "${!k:-${v:-$def}}"
}

render_adapter() {
  local tmpl="$REPO_ROOT/configs/${KVP_MODEL_CONFIG:-mimo-v2.6-pro}/l2-adapter.json.in"
  [ -f "$tmpl" ] || { echo "adapter template not found: $tmpl (set KVP_REPO_ROOT and KVP_MODEL_CONFIG)" >&2; exit 1; }
  local root budget serde_json codec
  root="$(repo_cfg KVP_CACHE_ROOT /var/lib/kv-persistence/l2)"
  budget="$(repo_cfg KVP_CACHE_BUDGET_GB 1500)"
  # Lossless L2 codec (same rules as scripts/start-cache.sh): none|raw = no
  # "serde" key (byte-exact), zstd|lz4 = the lossless kvp-* serde. Anything
  # lossy is refused -- kv-persistence is lossless by contract.
  # Review fix: the operator switch USE_LOSSLESS_SERDE must be honoured here
  # too, otherwise a systemd-started server could store under a DIFFERENT
  # codec than the one the identity namespace was hashed from (the switch is
  # folded into LMCACHE_L2_SERDE by scripts/env.sh, which systemd does not
  # source). Precedence matches env.sh: explicit LMCACHE_L2_SERDE env wins,
  # then USE_LOSSLESS_SERDE, then the config file.
  _env_serde="${LMCACHE_L2_SERDE:-${KVP_L2_SERDE:-}}"
  _switch_serde=""
  case "${USE_LOSSLESS_SERDE:-}" in
    1|yes|true|zstd) _switch_serde=zstd ;;
    lz4)             _switch_serde=lz4 ;;
    0|no|false|none|"") : ;;
    *) echo "USE_LOSSLESS_SERDE=${USE_LOSSLESS_SERDE} not understood (use 1 / zstd / lz4 / 0)" >&2; exit 1 ;;
  esac
  if [ -n "$_env_serde" ]; then
    codec="$(printf '%s' "$_env_serde" | tr '[:upper:]' '[:lower:]')"
  elif [ -n "$_switch_serde" ]; then
    codec="$_switch_serde"
  else
    codec="$(printf '%s' "$(repo_cfg LMCACHE_L2_SERDE none)" | tr '[:upper:]' '[:lower:]')"
  fi
  case "$codec" in
    none|raw) serde_json="" ;;
    zstd|lz4)
      serde_json="\"serde\": {\"type\": \"kvp-$codec\", \"level\": \"${KVP_L2_COMPRESS_LEVEL:-3}\", \"align_bytes\": \"4096\"},"
      # Fail-fast (review fix): verify the codec's Python bindings BEFORE the
      # server starts, otherwise it reaches READY and every store fails later
      # inside the serde thread pool (log-only).
      PYTHONPATH="${REPO_ROOT:+$REPO_ROOT/implementation}${PYTHONPATH:+:$PYTHONPATH}" \
        python3 -c "from kvpersist.compress_serde import check_codec_available; check_codec_available('$codec')" \
        || { echo "lossless codec '$codec' is not available in this python -- install it (pip install $([ "$codec" = zstd ] && echo zstandard || echo lz4)) or fall back to LMCACHE_L2_SERDE=none" >&2; exit 1; }
      ;;
    fp8|turboquant|lbq|cachegen|kivi|asym*)
      echo "LMCACHE_L2_SERDE=$codec is LOSSY -- kv-persistence is lossless-only (none / zstd / lz4)" >&2; exit 1 ;;
    *) echo "LMCACHE_L2_SERDE=$codec not understood (use none / zstd / lz4)" >&2; exit 1 ;;
  esac
  # Review fix (round 37): the JSON watermark and the server flag must come
  # from the SAME source -- the flag uses repo_cfg, so must the JSON (the bare
  # env default ignored an lmcache-server.env edit).
  sed -e "s|__KVP_CACHE_ROOT__|$root|" \
      -e "s|__KVP_CACHE_BUDGET_GB__|$budget|" \
      -e "s|__KVP_EVICT_TRIGGER_WATERMARK__|$(repo_cfg LMCACHE_EVICTION_TRIGGER_WATERMARK 0.9)|" \
      -e "s|__KVP_EVICT_RATIO__|$(repo_cfg LMCACHE_EVICTION_RATIO 0.1)|" \
      -e "s|__KVP_L2_SERDE_JSON__|$serde_json|" \
      "$tmpl" \
    | python3 -c 'import json,re,sys; s=sys.stdin.read(); s=re.sub(r"^\s*//.*$","",s,flags=re.M); json.loads(s); sys.stdout.write(s)'
}

# Review round 14: the cache root must exist and be writable by the service
# user (the systemd unit runs as `kvp`, the directory is usually root-owned).
# StateDirectory= in the unit handles the default path; for a custom
# KVP_CACHE_ROOT we create it here (best effort).
# Review fix (round 17): the directory must also be 0700, not just writable.
# docs/security.md promises chmod 700 -- KV data is chat text in disguise --
# but systemd's StateDirectory= creates /var/lib/kv-persistence with 0755 and
# the old mkdir -p never tightened it: a world-readable cache root. Enforce
# 0700 here and refuse to start without it.
ensure_cache_root() {
  local root budget
  root="$(repo_cfg KVP_CACHE_ROOT /var/lib/kv-persistence/l2)"
  if [ ! -d "$root" ]; then
    mkdir -p "$root" 2>/dev/null \
      || { echo "cannot create cache root $root -- create it first (see docs/deployment.md systemd section)" >&2; exit 1; }
  fi
  if [ ! -w "$root" ]; then
    echo "cache root $root is not writable by $(id -un) -- run:" >&2
    echo "  sudo install -d -o kvp -g kvp -m 0700 $root" >&2
    exit 1
  fi
  # 0700 is a SECURITY contract (docs/security.md). Failure is fatal: starting
  # with a group/world-readable cache root would silently weaken the
  # documented threat model.
  chmod 700 "$root" 2>/dev/null \
    || { echo "cannot chmod 700 $root -- KV data would be readable by other local users; refusing to start (see docs/security.md)" >&2; exit 1; }
  # Also tighten the parent (StateDirectory default) if we own it.
  local parent
  parent="$(dirname "$root")"
  if [ -d "$parent" ] && [ -w "$parent" ]; then
    chmod 700 "$parent" 2>/dev/null || true
  fi
}

if [ -n "$ADAPTER_FILE" ] && [ -f "$ADAPTER_FILE" ]; then
  ADAPTER_JSON="$(cat "$ADAPTER_FILE")"
else
  [ -n "$REPO_ROOT" ] || { echo "no adapter file and KVP_REPO_ROOT is unset -- cannot render the L2 spec" >&2; exit 1; }
  ADAPTER_JSON="$(render_adapter)"
fi
echo "$ADAPTER_JSON" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
  || { echo "adapter spec is not valid JSON" >&2; exit 1; }
# Review fix (round 37, HIGH): write the rendered adapter to the cache root
# so the identity gate's l2_serde check can read it. Without this file the
# mandatory post-launch gate in the recipe launchers always gets exit 5
# (INCONCLUSIVE) when the cache runs under systemd -- scripts/start-cache.sh
# writes it at line ~133 but this wrapper did not.
# Review fix (round 38): ensure_cache_root BEFORE the render write -- on a
# first start the cache dir does not exist yet and the old order silently
# skipped the write (the gate then reported INCONCLUSIVE until a service
# restart). ensure_cache_root also enforces the 0700 security contract.
ensure_cache_root
_root_for_render="$(repo_cfg KVP_CACHE_ROOT /var/lib/kv-persistence/l2)"
if [ -d "$_root_for_render" ] && [ -w "$_root_for_render" ]; then
  printf '%s\n' "$ADAPTER_JSON" > "$_root_for_render/l2-adapter.rendered.json" 2>/dev/null \
    || echo "WARNING: cannot write l2-adapter.rendered.json to $_root_for_render (gate will report INCONCLUSIVE)" >&2
else
  echo "WARNING: cache root $_root_for_render missing/not writable -- l2-adapter.rendered.json NOT written (gate will report INCONCLUSIVE)" >&2
fi
# Review round 14: the service user must be able to write the cache root.
# (round 38: ensure_cache_root moved BEFORE the adapter render -- see above.)
# Review round 15+: launch through the kv-persistence launcher (kvpersist.launch)
# which applies BOTH runtime patches: the cache_salt filename fix AND the
# lossless compression serde registration (see kvpersist/launch.py).
# Review fix (round 18): LMCACHE_LOG_LEVEL must reach the service process.
# The repo config files (lmcache-server.env) are read by scripts/env.sh for the
# shell launchers, but this wrapper reads only via repo_cfg() -- export the
# effective value here so the systemd launch matches the script launch. The
# default is DEBUG (required for the acceptance evidence lines; see
# configs/generic/lmcache-server.env).
export LMCACHE_LOG_LEVEL
LMCACHE_LOG_LEVEL="${LMCACHE_LOG_LEVEL:-$(repo_cfg LMCACHE_LOG_LEVEL DEBUG)}"
# Review fix (round 27): port, L1 size, chunk size and eviction MUST also come
# from the repo config files via repo_cfg -- previously they fell back to bare
# defaults (5555 / 64 / 256) and KVP_* edits in cache.env(.local) were silently
# ignored under systemd. repo_cfg precedence: process env > .local > base file
# > the defaults here -- identical to scripts/env.sh.
# Review fix (round 37): the loopback check is a SECURITY contract
# (docs/security.md) -- scripts/start-cache.sh refuses 0.0.0.0 and so must
# this wrapper. Also read HTTP/OTLP settings from the repo configs via
# repo_cfg (start-cache.sh parity): bare env misses lmcache-server.env edits.
_lm_host="$(repo_cfg LMCACHE_HOST 127.0.0.1)"
case "$_lm_host" in
  127.0.0.1|localhost|::1) : ;;
  *) echo "LMCACHE_HOST must be loopback-only (127.0.0.1/localhost/::1), got '$_lm_host'" >&2; exit 1 ;;
esac
_lm_http_host="$(repo_cfg LMCACHE_HTTP_HOST 127.0.0.1)"
# Review fix (round 38): the HTTP admin frontend binds loopback ONLY
# (docs/security.md) -- 0.0.0.0 was silently accepted here and in
# start-cache.sh.
case "$_lm_http_host" in
  127.0.0.1|localhost|::1) : ;;
  *) echo "LMCACHE_HTTP_HOST must be loopback-only (127.0.0.1/localhost/::1), got '$_lm_http_host'" >&2; exit 1 ;;
esac
_lm_http_port="$(repo_cfg LMCACHE_HTTP_PORT "")"
_lm_otlp="$(repo_cfg LMCACHE_OTLP_ENDPOINT "")"
exec python3 -m kvpersist.launch server \
  --host "$_lm_host" \
  --port "$(repo_cfg LMCACHE_PORT 5555)" \
  --l1-size-gb "$(repo_cfg LMCACHE_L1_SIZE_GB 64)" \
  --eviction-policy "$(repo_cfg LMCACHE_EVICTION_POLICY LRU)" \
  --eviction-trigger-watermark "$(repo_cfg LMCACHE_EVICTION_TRIGGER_WATERMARK 0.9)" \
  --eviction-ratio "$(repo_cfg LMCACHE_EVICTION_RATIO 0.1)" \
  --chunk-size "$(repo_cfg LMCACHE_CHUNK_SIZE 256)" \
  --l2-adapter "$ADAPTER_JSON" \
  ${_lm_http_port:+--http-host "$_lm_http_host"} \
  ${_lm_http_port:+--http-port "$_lm_http_port"} \
  ${_lm_otlp:+--otlp-endpoint "$_lm_otlp"} \
  ${_lm_otlp:+--enable-tracing}