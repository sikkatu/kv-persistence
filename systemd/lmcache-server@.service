# systemd/lmcache-server@.service -- TEMPLATE unit (per-instance user).
# Install:
#   sudo install -m 0755 systemd/kvp-lmcache-server /usr/local/sbin/kvp-lmcache-server
#   sudo install -m 0644 systemd/lmcache-server@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lmcache-server@kvp
# The instance name (%i) is the user to run as -- this is the ONLY unit form
# where User=%i is valid (in a plain unit it is an invalid user name).

[Unit]
Description=LMCache server (persistent KV cache for vLLM, kv-persistence, instance %i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
Group=%i
Environment=PYTHONUNBUFFERED=1
# README clones to ~/kv-persistence; override in /etc/kv-persistence.env.
# The wrapper reads cache.env/.local for KVP_CACHE_ROOT and the budget (same
# "env wins over files" rule as scripts/env.sh).
Environment=KVP_REPO_ROOT=/home/kvp/kv-persistence
EnvironmentFile=-/etc/kv-persistence.env
# Cache root ownership: StateDirectory= creates /var/lib/kv-persistence owned
# by the instance user. For a custom KVP_CACHE_ROOT run once:
#   sudo install -d -o <user> -g <user> -m 0700 <your-cache-root>
StateDirectory=kv-persistence
ExecStart=/usr/local/sbin/kvp-lmcache-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target