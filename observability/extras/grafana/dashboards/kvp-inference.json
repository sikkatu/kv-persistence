  {
   "id": 17,
   "type": "gauge",
   "title": "KV usage %",
   "description": "Shared KV pool fill (all requests). Yellow 80%, red 90%: at >=90% preemptions begin.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 4,
