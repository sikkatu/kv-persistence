      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "noValue": "no data -- see extras/README.md#empty-panels",
     "min": 0,
     "max": 100,
     "thresholds": {
      "steps": [
       {
        "color": "green"
       },
       {
        "color": "yellow",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Preemptions/s (any spike = KV pressure)",
   "description": "Requests evicted from the KV cache under memory pressure -- forces prompt re-computation. Anything >0 is red: enlarge the KV pool (gpu-memory-utilization) or lower MAX_NUM_SEQS.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 22,
