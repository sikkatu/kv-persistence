   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "no data -- see extras/README.md#empty-panels",
     "min": 0,
     "max": {
      "thresholds": {
       "steps": [
        {
         "color": "green"
        },
        {
         "color": "red",
         "value": 0
        }
       ]
      }
