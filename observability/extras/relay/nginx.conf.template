# extras/relay/nginx.conf.template -- rendered by start-observability.sh into
# live/obs-relay/nginx.conf (the placeholders @ENGINE_PORT@ and @LISTEN_IP@
# are substituted there; live/ is gitignored).
#
# Why this relay exists: the vLLM engine listens on 127.0.0.1 only (the
# recipe's security contract) while Prometheus runs in the Docker bridge
# network and cannot see host loopback. The relay listens on the bridge
# gateway address ONLY (never 0.0.0.0) and forwards GET /metrics -- nothing
# else. No Authorization header is forwarded.
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx-kvp-relay.pid;

events { worker_connections 128; }

http {
  access_log off;
  client_body_temp_path /tmp/nginx-body;
  proxy_temp_path /tmp/nginx-proxy;
  fastcgi_temp_path /tmp/nginx-fastcgi;
  uwsgi_temp_path /tmp/nginx-uwsgi;
  scgi_temp_path /tmp/nginx-scgi;

  server {
    listen @LISTEN_IP@:@RELAY_PORT@;
    server_name _;

    # exactly one endpoint, GET only (405 for any other method)
    location = /metrics {
      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
      proxy_pass http://127.0.0.1:@ENGINE_PORT@/metrics;
      proxy_set_header Host 127.0.0.1:@ENGINE_PORT@;
      proxy_set_header Authorization "";
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
    }

    location / {
      if ($request_method !~ ^(GET|HEAD)$) { return 405; }
      return 404;
    }
  }
}
